# ===== Config Server (repo Git con la configuración de los microservicios) =====
CONFIG_GIT_URI=https://github.com/<tu-usuario>/<tu-repo-config>.git
CONFIG_GIT_USERNAME=<tu-usuario-github>
CONFIG_GIT_TOKEN=<tu-personal-access-token>

# ===== Correo (auth-server) — credenciales del inbox de Mailtrap =====
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=<tu-usuario-mailtrap>
MAILTRAP_PASSWORD=<tu-password-mailtrap>
MAILTRAP_FROM=no-reply@demomailtrap.co

# ===== Frontend (links de los correos) =====
FRONTEND_URL=https://localhost:4200

# ===== Cookie del refresh token (auth-server) =====
# false para desarrollo sin HTTPS (Postman, http://IP-local, Safari). En produccion: true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
